# Keep the same execution order as the original deferred page scripts.
# Monaco has separate worker contexts and remains lazy-loaded by code-editor.js.
get_filename_component(COOLDER_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(frontend_sources i18n.js app.js personal.js code-editor.js attachments.js admin.js)
set(bundle "// Generated by tools/bundle_frontend.cmake. Edit the source files, not this bundle.\n'use strict';\n")
foreach(source IN LISTS frontend_sources)
  file(READ "${COOLDER_ROOT}/html/${source}" content)
  string(APPEND bundle "\n;\n// ---- ${source} ----\n${content}\n")
endforeach()
set(output "${COOLDER_ROOT}/html/coolder.js")
if(EXISTS "${output}")
  file(READ "${output}" previous)
  if(previous STREQUAL bundle)
    return()
  endif()
endif()
file(WRITE "${output}.tmp" "${bundle}")
file(RENAME "${output}.tmp" "${output}")
