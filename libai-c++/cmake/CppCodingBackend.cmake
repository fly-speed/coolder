# The public facade converts values and privately embeds the shared core objects.
include("${CMAKE_CURRENT_LIST_DIR}/../../libai/cmake/CodingBackend.cmake")
libai_enable_coding(libai_cpp)
target_sources(libai_cpp PRIVATE src/provider_model.cpp)
target_compile_definitions(libai_cpp PUBLIC LIBAI_CPP_FULL)
add_library(libai_cpp_host INTERFACE)
add_library(libai::cpp_host ALIAS libai_cpp_host)
target_link_libraries(libai_cpp_host INTERFACE libai::cpp libai_dependencies)
target_include_directories(libai_cpp_host INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/src" "${CMAKE_CURRENT_SOURCE_DIR}/.." "${CMAKE_CURRENT_SOURCE_DIR}/../libai")
target_compile_definitions(libai_cpp_host INTERFACE LIBAI_CPP_HOST_INTERNAL ACL_USE_CPP11)
if(WIN32)
 target_compile_definitions(libai_cpp PRIVATE ACL_WINDOWS WIN32_LEAN_AND_MEAN NOMINMAX)
 target_compile_definitions(libai_cpp_host INTERFACE ACL_WINDOWS WIN32_LEAN_AND_MEAN NOMINMAX)
endif()
if(AI_CODING_BUILD_TESTS AND NOT TARGET libai_coding)
 add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../libai" "${CMAKE_CURRENT_BINARY_DIR}/native-tests" EXCLUDE_FROM_ALL)
 add_custom_target(libai_cpp_backend_tests ALL DEPENDS ai_agent_test ai_sdk_provider_test
  ai_sdk_workspace_test ai_common_primitives_test ai_repair_scope_test ai_coding_link_test)
endif()
