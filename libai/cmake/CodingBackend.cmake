# Compile maintained libai sources once per build; language bindings embed the objects.
set(_LIBAI_CODING_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
function(libai_enable_coding target)
 if(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
  message(FATAL_ERROR "Full coding requires desktop ACL; mobile agent APIs remain supported")
 endif()
 set(ACL_PATH "${_LIBAI_CODING_ROOT}/../third-party/acl" CACHE PATH "Prebuilt ACL root")
 set(OPENSSL_PATH "${_LIBAI_CODING_ROOT}/../third-party/openssl" CACHE PATH "Prebuilt OpenSSL root")
 include("${_LIBAI_CODING_ROOT}/cmake/Dependencies.cmake")
 if(NOT TARGET libai_coding_objects)
  set(_sources)
  foreach(_module agent provider storage project workspace sandbox context prompt validation common runtime coding)
   file(GLOB _module_sources CONFIGURE_DEPENDS "${_LIBAI_CODING_ROOT}/${_module}/*.cpp")
   list(APPEND _sources ${_module_sources})
  endforeach()
  add_library(libai_coding_objects OBJECT ${_sources})
  set_target_properties(libai_coding_objects PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_compile_features(libai_coding_objects PRIVATE cxx_std_11)
  target_include_directories(libai_coding_objects PRIVATE "${_LIBAI_CODING_ROOT}" "${_LIBAI_CODING_ROOT}/..")
  target_link_libraries(libai_coding_objects PRIVATE webcool_ai_dependencies)
  target_compile_definitions(libai_coding_objects PRIVATE ACL_USE_CPP11 _REENTRANT _POSIX_PTHREAD_SEMANTICS _USE_FAST_MACRO)
  if(APPLE)
   target_compile_definitions(libai_coding_objects PRIVATE MACOSX)
   target_compile_options(libai_coding_objects PRIVATE -Wno-invalid-source-encoding -Wno-invalid-offsetof)
  elseif(WIN32)
   target_compile_definitions(libai_coding_objects PRIVATE ACL_WINDOWS WIN32_LEAN_AND_MEAN NOMINMAX _CRT_SECURE_NO_WARNINGS _WINSOCK_DEPRECATED_NO_WARNINGS)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
   target_compile_definitions(libai_coding_objects PRIVATE FREEBSD)
  endif()
  if(MSVC)
   target_compile_options(libai_coding_objects PRIVATE /utf-8 /Zc:__cplusplus)
  endif()
 endif()
 target_sources(${target} PRIVATE $<TARGET_OBJECTS:libai_coding_objects>)
 target_link_libraries(${target} PRIVATE webcool_ai_dependencies)
 target_compile_definitions(${target} PRIVATE LIBAI_CODING_FULL ACL_USE_CPP11)
endfunction()
