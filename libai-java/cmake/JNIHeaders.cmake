# The JVM loads this bridge; it needs JNI headers, not AWT or libjvm linkage.
# Keep this header-only discovery compatible with CMake 3.16.
find_package(Java REQUIRED COMPONENTS Development)
if(LIBAI_JNI_INCLUDE_DIR)
 set(_libai_jni_candidates "${LIBAI_JNI_INCLUDE_DIR}")
else()
 execute_process(COMMAND "${Java_JAVA_EXECUTABLE}" -XshowSettings:properties -version
  OUTPUT_VARIABLE _libai_java_stdout ERROR_VARIABLE _libai_java_settings)
 string(REGEX MATCH "java.home = ([^\r\n]+)" _libai_java_home_match "${_libai_java_settings}")
 string(STRIP "${CMAKE_MATCH_1}" _libai_java_home)
 set(_libai_jni_candidates "$ENV{JAVA_HOME}/include" "${_libai_java_home}/include" "${_libai_java_home}/../include")
 if(APPLE)
  execute_process(COMMAND /usr/libexec/java_home OUTPUT_VARIABLE _libai_registered_jdk
   ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(_libai_registered_jdk)
   list(APPEND _libai_jni_candidates "${_libai_registered_jdk}/include")
  endif()
 endif()
 # Android Studio's desktop JDK may omit headers. NDK's VM-neutral JNI header
 # also works on POSIX desktop JVMs; never use this fallback on Windows.
 if(UNIX)
  set(_libai_ndks "$ENV{ANDROID_NDK_HOME}" "$ENV{ANDROID_NDK_ROOT}" "$ENV{ANDROID_NDK}")
  set(_libai_android_sdks "$ENV{ANDROID_HOME}" "$ENV{ANDROID_SDK_ROOT}")
  if(APPLE)
   list(APPEND _libai_android_sdks "$ENV{HOME}/Library/Android/sdk")
  else()
   list(APPEND _libai_android_sdks "$ENV{HOME}/Android/Sdk")
  endif()
  foreach(_libai_sdk IN LISTS _libai_android_sdks)
   if(_libai_sdk)
    file(GLOB _libai_installed_ndks LIST_DIRECTORIES true "${_libai_sdk}/ndk/*")
    list(SORT _libai_installed_ndks)
    list(REVERSE _libai_installed_ndks)
    list(APPEND _libai_ndks ${_libai_installed_ndks} "${_libai_sdk}/ndk-bundle")
   endif()
  endforeach()
  foreach(_libai_ndk IN LISTS _libai_ndks)
   if(_libai_ndk)
    file(GLOB _libai_ndk_headers "${_libai_ndk}/toolchains/llvm/prebuilt/*/sysroot/usr/include")
    list(APPEND _libai_jni_candidates ${_libai_ndk_headers} "${_libai_ndk}/sysroot/usr/include")
   endif()
  endforeach()
 endif()
endif()
set(_libai_jni_found false)
foreach(_libai_include IN LISTS _libai_jni_candidates)
 if(NOT EXISTS "${_libai_include}/jni.h")
  continue()
 endif()
 file(READ "${_libai_include}/jni.h" _libai_jni_header)
 set(_libai_platform_include "")
 if(_libai_jni_header MATCHES "#[ \t]*include[ \t]*[<\"]jni_md.h[>\"]")
  if(WIN32)
   set(_libai_platform win32)
  elseif(APPLE)
   set(_libai_platform darwin)
  else()
   set(_libai_platform linux)
  endif()
  if(EXISTS "${_libai_include}/${_libai_platform}/jni_md.h")
   set(_libai_platform_include "${_libai_include}/${_libai_platform}")
  elseif(NOT EXISTS "${_libai_include}/jni_md.h")
   continue()
  endif()
 endif()
 set(LIBAI_JNI_INCLUDE_DIR "${_libai_include}" CACHE PATH "Directory containing JNI headers" FORCE)
 # Copy only the standalone AOSP JNI header. Adding an NDK sysroot include
 # directory to a desktop target would shadow the host libc headers.
 if(UNIX AND _libai_jni_header MATCHES "The Android Open Source Project" AND NOT _libai_platform_include)
  set(_libai_desktop_headers "${CMAKE_CURRENT_BINARY_DIR}/jni-headers")
  file(MAKE_DIRECTORY "${_libai_desktop_headers}")
  configure_file("${_libai_include}/jni.h" "${_libai_desktop_headers}/jni.h" COPYONLY)
  target_include_directories(libai_jni PRIVATE "${_libai_desktop_headers}")
 else()
  target_include_directories(libai_jni PRIVATE "${_libai_include}")
 endif()
 if(_libai_platform_include)
  target_include_directories(libai_jni PRIVATE "${_libai_platform_include}")
 endif()
 message(STATUS "JNI headers: ${_libai_include} (AWT/JVM libraries not required)")
 set(_libai_jni_found true)
 break()
endforeach()
if(NOT _libai_jni_found)
 message(FATAL_ERROR "JNI headers not found. Set JAVA_HOME to a complete JDK containing include/jni.h, or pass -DLIBAI_JNI_INCLUDE_DIR=/path/to/jni/headers. Android Studio JDKs may omit these headers; on macOS/Linux an installed Android NDK can supply them (ANDROID_SDK_ROOT or ANDROID_NDK_HOME).")
endif()
